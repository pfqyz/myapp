
<%= render 'shared/errors', object: @user %>
<h1>Log in</h1>

<%= form_with url: login_path, local: true do |f| %>
    <div class="form-group">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, placeholder: 'E-mail', class: 'form-box' %>
    </div>

    <div class="form-group">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, placeholder: 'Password', class: 'form-box' %>
    </div>
    
    <%= f.submit "Log in", class: "form-submit-btn" %>
    
<% end %>