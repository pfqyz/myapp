<!-- app/views/pages/_sidebar.html.erb -->
<aside class="column sidebar-workspace">
  
  <!-- Profile -->
  <div class="sidebar-top">
    <%= link_to profile_path, class: "profile-card-link" do %>
      <span class="material-symbols-outlined icon">account_circle</span>
      <div class="info">
        <span class="profile-name"><%= @user.name %></span>
        <span class="hint">Go to profile</span>
      </div>
    <% end %>
  </div>
  
  <!-- Folder -->
  <div class="sidebar-top">
    <%= link_to folders_path, class: "sidebar-bottom-link" do %> <!-- ИЗМЕНИЛИ ПУТЬ -->
      <span class="material-symbols-outlined icon">folder</span>
      <div class="info">
          Folders
        <span class="hint">Go to folders</span>
      </div>
    <% end %>
  </div>
  
  <!-- Schedule -->
  <div class="sidebar-top">
    <%= link_to schedule_path, class: "sidebar-bottom-link" do %> <!-- ИЗМЕНИЛИ ПУТЬ -->
      <span class="material-symbols-outlined icon">calendar_month</span>
      <div class="info">
          Schedule
        <span class="hint">Go to your schedule</span>
      </div>
    <% end %>
  </div>
  
  <!-- Deleted -->
  <div class="sidebar-top">
    <%= link_to deleted_files_path, class: "sidebar-bottom-link" do %> <!-- ИЗМЕНИЛИ ПУТЬ -->
      <span class="material-symbols-outlined icon">delete</span>
      <div class="info">
          Deleted
        <span class="hint">Go to deleted files</span>
      </div>
    <% end %>
  </div>

      <!-- НИЖНИЙ БЛОК С КНОПКАМИ -->
  <div class="sidebar-bottom">
    <div class="bottom-nav-container">
      
      <!-- Кнопка Home -->
        <% unless current_page?(main_path) %>
            <%= link_to main_path, class: "footer-nav-link" do %>
                <span class="material-symbols-outlined icon">home</span>
                <span class="link-text">Home</span>
            <% end %>
        <% end %>
      <!-- Кнопка Log out (Используем button_to для надежности) -->
      <%= button_to logout_path, method: :delete, class: "footer-nav-link logout-btn" do %>
        <span class="material-symbols-outlined icon">logout</span>
        <span class="link-text">Log out</span>
      <% end %>

    </div>
  </div>

</aside>