<div class="three-column-layout">
  
  <!-- Левая колонка — Сайдбар в чистом кастомном стиле -->
  <aside class="column sidebar-workspace">
    
    <!-- Верхний блок: Профиль -->
    <div class="sidebar-top">
      <%= link_to profile_path, class: "profile-card-link" do %>
        <span class="material-symbols-outlined profile-icon">account_circle</span>
        <div class="profile-info">
          <span class="profile-name"><%= @user.name %></span>
          <span class="profile-hint">Go to profile</span>
        </div>
      <% end %>
    </div>

    <!-- Нижний блок: Выход (Железобетонный button_to, прижатый к низу) -->
    <div class="sidebar-bottom">
      <%= icon_link_to "Log out", logout_path, "logout", data: { turbo_method: :delete }, class: "logout-btn custom-icon-link" %>
    </div>
    
  </aside>

  <!-- Центральная колонка -->
  <main class="column content-center">
    <div class="notes-header">
      <h2>My notes</h2>
      <p>Your personal NotePage notes will be displayed here.</p>
    </div>
  </main>

  <!-- Правая колонка -->
  <aside class="column sidebar-right">
    <h2>TO DO</h2>
    <p>Your tasks will be displayed here.</p>
  </aside>

</div>
