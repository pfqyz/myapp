<%if logged_in?%>
    <%= link_to "Profile", profile_path, class: 'btn btn-primary me2'%>
    <%= link_to "Log out", logout_path, data: { turbo_method: :delete }, class: 'btn btn-primary'%>
<%else%>
    <%= link_to "Registration", new_user_path, class: 'btn btn-primary me2' %>
    <%= link_to "Log in", login_path, class: 'btn btn-primary'%>
<%end%>